# PostgreSQL
DATABASE_URL=postgresql+psycopg://pico:pico@localhost:5432/pico_web

# Authentication / encryption secrets (generate with a cryptographically secure generator)
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-a-Fernet-key

# Set to production to enforce all required secrets
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
